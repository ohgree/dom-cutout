{
  "name": "dom-cutout",
  "version": "0.1.0",
  "description": "Cut the silhouette of one DOM element out of another — badge cutouts, notification dots, status halos — with a runtime-generated SVG mask that follows the overlay's contours. Zero-dependency core, React adapter included.",
  "keywords": [
    "badge",
    "css-mask",
    "cut-out",
    "cutout",
    "mask",
    "notification-dot",
    "react",
    "svg-mask"
  ],
  "license": "MIT",
  "author": "MJ Shin <ohgree.dev@gmail.com> (https://github.com/ohgree)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ohgree/dom-cutout.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/react.tsx --format esm,cjs --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepublishOnly": "pnpm type-check && pnpm lint && pnpm format:check && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.34.3"
}

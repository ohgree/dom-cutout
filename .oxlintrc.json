{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "plugins": ["typescript", "react", "unicorn", "oxc"],
  "rules": {
    "react/react-in-jsx-scope": "off"
  },
  "env": {
    "browser": true
  },
  "ignorePatterns": ["dist", "node_modules", "examples/dist"]
}

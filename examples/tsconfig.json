{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": {
      "dom-cutout/react": ["../src/react.tsx"],
      "dom-cutout": ["../src/index.ts"]
    }
  },
  "include": ["react", "vanilla", "demo", "landing.ts", "vite.config.ts"]
}
